{
  "name": "vae-lightstick",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
